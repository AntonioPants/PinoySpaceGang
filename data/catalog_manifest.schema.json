{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/planetary-analog-sim/catalog_manifest.schema.json",
  "title": "Planetary Analog Data Catalog",
  "type": "object",
  "required": ["schema_version", "resources", "datasets", "sites"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "resources": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/resource"}
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/dataset"}
    },
    "sites": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/site"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["provider", "title", "role", "access", "url"],
      "properties": {
        "provider": {"type": "string"},
        "title": {"type": "string"},
        "role": {"type": "string"},
        "access": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["provider", "resource_id", "product", "citation", "url"],
      "properties": {
        "provider": {"type": "string"},
        "resource_id": {"type": "string"},
        "product": {"type": "string"},
        "short_name": {"type": "string"},
        "citation": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["name", "type", "body", "bbox", "bbox_crs", "default_dataset"],
      "properties": {
        "name": {"type": "string"},
        "type": {"enum": ["earth_analog", "planetary_site"]},
        "body": {"enum": ["earth", "moon", "mars"]},
        "bbox": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "bbox_crs": {"type": "string"},
        "default_dataset": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
