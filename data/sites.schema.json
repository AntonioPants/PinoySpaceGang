{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "coordinate_convention",
    "sites",
    "pairings",
    "analog_matching"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "pairings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pairing"
      }
    },
    "analog_matching": {
      "type": "object",
      "required": [
        "method_version",
        "scope",
        "weights",
        "environment_weights",
        "weight_status",
        "ranking_method",
        "selection",
        "comparisons"
      ],
      "properties": {
        "method_version": {
          "const": "2.1.0"
        },
        "weight_status": {
          "const": "engineering_assumption_not_calibrated"
        },
        "selection": {
          "type": "object",
          "required": [
            "top_k",
            "min_exploratory_score_percent",
            "algorithm",
            "potential_pairs",
            "detailed_pairs",
            "reused_proposal_audits",
            "pruned_pairs",
            "filtered_pairs",
            "screening"
          ],
          "properties": {
            "top_k": {
              "const": 10
            },
            "min_exploratory_score_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "potential_pairs": {
              "type": "integer",
              "minimum": 0
            },
            "detailed_pairs": {
              "type": "integer",
              "minimum": 0
            },
            "reused_proposal_audits": {
              "type": "integer",
              "minimum": 0
            },
            "pruned_pairs": {
              "type": "integer",
              "minimum": 0
            },
            "filtered_pairs": {
              "type": "integer",
              "minimum": 0
            },
            "screening": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "earth_id",
                  "planetary_id",
                  "status",
                  "reason",
                  "central_upper_bound_percent"
                ],
                "properties": {
                  "earth_id": {
                    "type": "string"
                  },
                  "planetary_id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "filtered",
                      "pruned",
                      "evaluated"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "central_upper_bound_percent": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "earth_id",
              "planetary_id",
              "candidate_rank",
              "analog_score_percent",
              "landform_match_percent",
              "landform",
              "evidence_status",
              "scientifically_validated",
              "validated_accuracy_percent",
              "terrain_similarity_percent",
              "environment_similarity_percent",
              "total_similarity_percent",
              "evidence_coverage_percent",
              "total_reason",
              "verification",
              "environment_features",
              "atmosphere",
              "geology",
              "input_elevation_sha256",
              "comparison_explanation"
            ],
            "properties": {
              "earth_id": {
                "type": "string"
              },
              "planetary_id": {
                "type": "string"
              },
              "candidate_rank": {
                "type": "integer",
                "minimum": 1
              },
              "evidence_status": {
                "enum": [
                  "literature_informed_proposal",
                  "exploratory_terrain_only"
                ]
              },
              "scientifically_validated": {
                "const": false
              },
              "validated_accuracy_percent": {
                "type": "null"
              },
              "total_reason": {
                "type": "string",
                "minLength": 1
              },
              "environment_features": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4
              },
              "terrain_similarity_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "environment_similarity_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "total_similarity_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "evidence_coverage_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "comparison_explanation": {
                "type": "object",
                "required": [
                  "status",
                  "matches",
                  "differences",
                  "sources",
                  "scope"
                ],
                "properties": {
                  "status": {
                    "const": "catalog_interpretation_unreviewed"
                  },
                  "matches": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "differences": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "status",
        "source",
        "native_resolution_m",
        "analysis_resolution_m",
        "time_coverage",
        "method",
        "caveat",
        "reason"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "m",
            "deg",
            "m/s",
            "degC",
            "K",
            "1",
            "Pa",
            "kg/m3"
          ]
        },
        "status": {
          "enum": [
            "measured",
            "derived",
            "modeled",
            "assumed",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "type": "object",
                "required": [
                  "product_id",
                  "url"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "site": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": [
              "catalog_origin"
            ],
            "properties": {
              "catalog_origin": {
                "const": "regional_scan"
              }
            }
          },
          "then": {
            "required": [
              "inferred_landforms",
              "scan_provenance",
              "matches",
              "morphology",
              "substrate"
            ],
            "properties": {
              "role": {
                "const": "earth_analog"
              },
              "body": {
                "const": "earth"
              },
              "morphology": {
                "const": "unknown"
              },
              "substrate": {
                "const": "unknown"
              },
              "matches": {
                "type": "array",
                "maxItems": 0
              },
              "terrain": {
                "type": "object"
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "name",
        "body",
        "role",
        "longitude",
        "latitude",
        "region",
        "description",
        "bbox",
        "terrain",
        "conditions",
        "comparison_features",
        "classification",
        "completeness",
        "limitations",
        "simulation_defaults"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "body": {
          "enum": [
            "earth",
            "moon",
            "mars"
          ]
        },
        "role": {
          "enum": [
            "earth_analog",
            "planetary_target"
          ]
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "terrain": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "manifest_url",
            "manifest_sha256",
            "elevation_sha256",
            "rows",
            "columns",
            "row_order",
            "column_order",
            "spacing_m",
            "source_url"
          ],
          "properties": {
            "row_order": {
              "const": "north_to_south"
            },
            "column_order": {
              "const": "west_to_east"
            },
            "rows": {
              "type": "integer",
              "minimum": 2
            },
            "columns": {
              "type": "integer",
              "minimum": 2
            },
            "spacing_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "elevation_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "comparison_features": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "catalog_origin": {
          "enum": [
            "regional_scan",
            "curated"
          ]
        },
        "inferred_landforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scan_provenance": {
          "type": "object",
          "required": [
            "method_version",
            "window_id",
            "region_id",
            "seed_site_ids",
            "source_urls",
            "index_sha256",
            "shortlist_sha256",
            "evidence_status",
            "inference_method"
          ],
          "properties": {
            "method_version": {
              "const": "1.0.0"
            },
            "window_id": {
              "type": "string",
              "pattern": "^scan-[a-z0-9-]+$"
            },
            "region_id": {
              "type": "string",
              "minLength": 1
            },
            "seed_site_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "source_urls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^https://"
              }
            },
            "index_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "shortlist_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence_status": {
              "const": "exploratory_terrain_only"
            },
            "inference_method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "morphology": {
          "enum": [
            "unknown",
            "badlands",
            "massif",
            "crater",
            "impact_crater",
            "volcanic_plain",
            "lava_field",
            "dune_field",
            "canyon",
            "rocky_desert",
            "delta",
            "playa",
            "polygonal_ground"
          ]
        },
        "substrate": {
          "enum": [
            "mixed_sand",
            "basalt",
            "basaltic_sand",
            "gypsum_sand",
            "sedimentary_rock",
            "evaporite",
            "permafrost",
            "icy_regolith",
            "lunar_regolith",
            "unknown"
          ]
        }
      }
    },
    "pairing": {
      "type": "object",
      "required": [
        "earth_id",
        "planetary_id",
        "terrain_score",
        "environment_score",
        "combined_score",
        "explanation",
        "accuracy_check"
      ],
      "properties": {
        "earth_id": {
          "type": "string"
        },
        "planetary_id": {
          "type": "string"
        },
        "explanation": {
          "type": "object",
          "required": [
            "status",
            "matches",
            "differences",
            "sources",
            "scope"
          ],
          "properties": {
            "status": {
              "const": "proposed_unvalidated"
            },
            "matches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "differences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "accuracy_check": {
          "$ref": "#/$defs/accuracy_check"
        }
      }
    },
    "accuracy_check": {
      "type": "object",
      "required": [
        "method_version",
        "status",
        "validated_accuracy_percent",
        "accuracy_reason",
        "recomputed_terrain_score",
        "catalog_features_reproduced",
        "window_sensitivity",
        "sources",
        "environment_checks",
        "feature_differences",
        "analysis",
        "geology",
        "coverage"
      ],
      "properties": {
        "method_version": {
          "const": "1.0.0"
        },
        "status": {
          "enum": [
            "reproduced_regional_comparison",
            "insufficient_or_inconsistent_data"
          ]
        },
        "validated_accuracy_percent": {
          "type": "null"
        },
        "accuracy_reason": {
          "type": "string",
          "minLength": 1
        },
        "recomputed_terrain_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "catalog_features_reproduced": {
          "type": "boolean"
        },
        "feature_differences": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "environment_checks": {
          "type": "array",
          "minItems": 7
        },
        "window_sensitivity": {
          "type": "object",
          "required": [
            "score_min",
            "score_max",
            "score_span",
            "valid_comparisons",
            "reason"
          ],
          "properties": {
            "valid_comparisons": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            },
            "score_min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "score_max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "score_span": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
