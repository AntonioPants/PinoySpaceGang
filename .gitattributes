# Checksums refer to these canonical text bytes on every platform.
*.json text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.geojson text eol=lf
*.f32 binary
*.tif binary
*.glb binary
*.png binary
*.pdf binary
# Generated receipts hash exact bytes, including producer-specific newlines.
# Do not transform them during add, stash or checkout.
web/public/terrain/** -text
data/earth_index/** -text
data/terrain-scales.json -text
