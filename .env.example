# Copy to .env and fill in what you have. EVERYTHING here is optional:
# the app runs end to end with no keys at all (NASA POWER, SoilGrids and MODIS need no login).

# --- NASA Earthdata (optional): enables SMAP L4 soil moisture + ECOSTRESS via AppEEARS ---
# Free account: https://urs.earthdata.nasa.gov/users/new
# Either username + password ...
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# ... or a token from https://urs.earthdata.nasa.gov/profile -> "Generate Token"
EARTHDATA_TOKEN=

# --- AI advisor (optional): without it the built-in rule-based advisor answers ---
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-opus-5-5

# --- Demo safety ---
# 1 = never touch the network; read only data/cache and the committed data/snapshot
FIELDSHIFT_OFFLINE=0

# Frontend -> engine address (used by web/next.config.mjs)
ENGINE_URL=http://127.0.0.1:8000
