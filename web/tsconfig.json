{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "paths": { "three": ["./node_modules/@types/three"], "three/*": ["./node_modules/@types/three/*", "./node_modules/three/*"], "react": ["./node_modules/@types/react"], "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"] },
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"]
}
