{
 "openapi": "3.1.0",
 "info": {
  "title": "Field Shift engine",
  "description": "Decision support for crop rotations from NASA Earth observations. Scores are relative comparisons, never yield or profit predictions.",
  "version": "0.1.0"
 },
 "paths": {
  "/api/health": {
   "get": {
    "tags": [
     "status"
    ],
    "summary": "Health",
    "description": "Status of every data source: configured, cached for this point, and (optionally) reachable.",
    "operationId": "health_api_health_get",
    "parameters": [
     {
      "name": "lat",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 75,
         "minimum": -60
        },
        {
         "type": "null"
        }
       ],
       "title": "Lat"
      }
     },
     {
      "name": "lon",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 180,
         "minimum": -180
        },
        {
         "type": "null"
        }
       ],
       "title": "Lon"
      }
     },
     {
      "name": "probe",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "Also make a live request to each open data service (slow)",
       "default": false,
       "title": "Probe"
      },
      "description": "Also make a live request to each open data service (slow)"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Health Api Health Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
