export type SiteId = 'kilbourne_hole' | 'meteor_crater' | 'amboy_crater' | 'badwater_basin' | 'white_sands' | 'utqiagvik_beo';
export type Season = 'DJF' | 'MAM' | 'JJA' | 'SON';
export type Scenario = 'typical' | 'high_wind';
export interface Statistics { units: string; valid_count: number; expected_count: number; coverage_fraction: number; mean: number | null; min: number | null; max: number | null; p05: number | null; p50: number | null; p95: number | null; stddev: number | null; }
export interface Weather { timestamp_utc: string; wind_speed_m_s: number; wind_from_deg: number; wind_east_m_s: number; wind_north_m_s: number; air_temperature_k: number; relative_humidity_pct: number; pressure_pa: number; precipitation_mm_h: number; air_density_kg_m3: number; }
export interface SurfaceMaterials { values: string[]; evidence: string; source_url: string; spatial_support: string; }
export interface SoilHorizon { survey_area_symbol: string; survey_area_name: string; map_unit_key: string; map_unit_name: string; component_key: string; component_name: string; component_kind: string; map_unit_component_pct: number | null; taxonomic_order: string | null; horizon_name: string | null; top_cm: number | null; bottom_cm: number | null; sand_pct: number | null; silt_pct: number | null; clay_pct: number | null; bulk_density_kg_m3: number | null; }
export interface SoilSurvey { status: 'available' | 'no_coverage' | 'unavailable'; source: Record<string, unknown>; horizons: SoilHorizon[]; error?: string; evidence?: string; }
export interface Period { statistics: Record<string, Statistics>; vector_mean_wind_from_deg: number | null; scenarios: Record<Scenario, Weather | null>; radiation: { albedo: Statistics; solar_daily_mean_w_m2: Statistics }; diurnal: { local_mean_solar_hour: number; record_count: number; air_temperature_k: number | null; wind_speed_m_s: number | null }[]; }
export interface EnvironmentProfile { schema_version: '1.0.0'; site: { id: SiteId; name: string; latitude: number; longitude: number; coordinate_role: string; surface_materials: SurfaceMaterials }; baseline: Record<string, unknown>; spatial_support: Record<string, string>; evidence: Record<string, string>; months: Record<string, Period>; seasons: Record<Season, Period>; soil: { survey?: SoilSurvey; [key: string]: unknown }; sources: Record<string, unknown>[]; unavailable: string[]; limitations: string[]; generated_at: string; }
export type GroundKey = 'contact_friction' | 'bulk_density_kg_m3' | 'cohesion_pa' | 'friction_angle_deg' | 'bearing_capacity_pa';
export interface MaterialOverride { value: number; evidence: 'measured' | 'assumed'; source: string; }
export type Selection = ({ month: number; season?: never } | { season: Season; month?: never }) & { scenario?: Scenario; materialOverrides?: Partial<Record<GroundKey, MaterialOverride>> };
export interface SimulationInputs { siteId: SiteId; period: number | Season; scenario: Scenario; weather: Weather & { wind_vector_m_s: [number, number, number] }; radiationContext: Period['radiation'] & { evidence: string; spatialSupport: string; use: string }; ground: Record<GroundKey, { value: number | null; units: string; evidence: 'measured' | 'assumed' | 'unavailable'; source: string | null }>; surfaceMaterials: SurfaceMaterials; soilSurvey: SoilSurvey | null; missingGroundParameters: GroundKey[]; limitations: string[]; }
export function validateProfile(profile: unknown): EnvironmentProfile;
export function loadEnvironmentProfile(baseUrl: string, siteId: SiteId, options?: { signal?: AbortSignal }): Promise<EnvironmentProfile>;
export function createSimulationInputs(profile: EnvironmentProfile, selection: Selection): SimulationInputs;
export function requireGroundParameters(inputs: SimulationInputs, names: GroundKey[]): void;
